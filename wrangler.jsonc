{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hush-music",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    { "binding": "MUSIC", "bucket_name": "hush-music" }
  ]
}
